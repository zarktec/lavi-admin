# --- Base de datos (Neon o Supabase vía Marketplace de Vercel) ---
DATABASE_URL=postgres://user:pass@host:5432/db

# --- Sesiones y cifrado (genera con: openssl rand -hex 32) ---
JWT_SECRET=
APP_ENCRYPTION_KEY=            # 32 bytes en hex; cifra los secretos TOTP del panel
CRON_SECRET=                   # Vercel lo envía como "Authorization: Bearer <CRON_SECRET>"

# --- Tags NFC (NTAG 424 DNA). Llaves maestras en hex de 16 bytes: "ref:hex,ref2:hex" ---
NFC_MASTER_KEYS=v1:00000000000000000000000000000000

# --- Dominio de la app (Universal Links / App Links) ---
APP_DOMAIN=app.tumarca.com
APP_BASE_URL=https://app.tumarca.com
ADMIN_BASE_URL=https://app.tumarca.com
IOS_APP_ID=TEAMID.com.tumarca.app
ANDROID_PACKAGE=com.tumarca.app
ANDROID_SHA256_FINGERPRINTS=AA:BB:...   # separadas por coma
IOS_STORE_URL=https://apps.apple.com/app/id0000000000
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.tumarca.app

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=mitienda.myshopify.com
SHOPIFY_SHOP_ID=               # id numérico de la tienda (Customer Account API)
SHOPIFY_ADMIN_TOKEN=           # token de la app privada (permiso de descuentos)
SHOPIFY_API_SECRET=            # secreto para validar HMAC de webhooks
SHOPIFY_API_VERSION=2025-07

# --- Correo transaccional (resend | postmark). Sin llave, se imprime en consola ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Tu Marca <no-reply@tumarca.com>

# --- Panel ---
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=12
ADMIN_INVITE_HOURS=24
